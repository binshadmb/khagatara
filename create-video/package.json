  "description": "",
  "dependencies": {
    "@remotion/cli": "^4.0.471",
    "@remotion/renderer": "^4.0.471",
    "openai": "^6.41.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "^4.0.471"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
